# API Base URL Configuration
# Uncomment the appropriate line for your environment:

# Local development
# VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Production (cPanel) - uncomment for deployment
VITE_API_BASE_URL=https://api.ghra.org.ng/api

# Flutterwave Public Key (get it from https://dashboard.flutterwave.com/settings/apis)
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxx-X
